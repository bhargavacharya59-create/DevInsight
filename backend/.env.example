# Database
DATABASE_URL=postgresql+asyncpg://devinsight:devinsight_pass@localhost:5432/devinsight_db
DATABASE_URL_SYNC=postgresql://devinsight:devinsight_pass@localhost:5432/devinsight_db

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Application
APP_ENV=development
SECRET_KEY=replace_with_a_long_random_secret
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Monitoring Mode: "demo" or "live"
MONITORING_MODE=live

# Shared ShopSphere ↔ DevInsight credential.
# Generate once (for example: openssl rand -hex 32) and use the SAME value
# in the root .env files of both repositories as INGEST_API_KEY.
INGEST_API_KEY=replace_with_the_same_random_secret_in_both_repositories
SHOPSPHERE_URL=http://localhost:8001
SHOPSPHERE_METRICS_URL=http://localhost:8001/metrics

# Prometheus / Loki / OpenTelemetry
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
OTEL_COLLECTOR_URL=http://localhost:4318

# Anomaly Detection
ANOMALY_CONTAMINATION=0.1
ANOMALY_THRESHOLD=-0.3
DETECTION_INTERVAL_SECONDS=30

# Demo
DEMO_SCENARIO_AUTO_PROGRESS=true

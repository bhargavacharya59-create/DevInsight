# DevInsight AI - Local Development

# ─────────────────────────────────────────────
# DATABASE (SQLite for local, PostgreSQL for Docker)
# ─────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./devinsight_dev.db
DATABASE_URL_SYNC=sqlite:///./devinsight_dev.db

# ─────────────────────────────────────────────
# GEMINI AI  ← ADD YOUR KEY HERE
# ─────────────────────────────────────────────
GEMINI_API_KEY=AQ.Ab8RN6Kjkns4B5azW2AkhYSgtrt_SFCRAQbuM6p4lfE6_eQ_RA
GEMINI_MODEL=gemini-2.5-flash

# ─────────────────────────────────────────────
# GITHUB INTEGRATION
# ─────────────────────────────────────────────
# Personal Access Token (repo, workflow, read:org scopes)
GITHUB_TOKEN=
# Owner/org of the ShopSphere repo  e.g. your-username
GITHUB_REPO_OWNER=
# Repository name  e.g. shopsphere
GITHUB_REPO_NAME=
# Webhook secret (set this in GitHub repo settings → Webhooks)
GITHUB_WEBHOOK_SECRET=devinsight-webhook-secret

# ─────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=dev-secret-key-local-only
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MONITORING_MODE=demo

# ─────────────────────────────────────────────
# TELEMETRY SOURCES  (live mode)
# ─────────────────────────────────────────────
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
OTEL_COLLECTOR_URL=http://localhost:4318

# ─────────────────────────────────────────────
# ANOMALY DETECTION
# ─────────────────────────────────────────────
ANOMALY_CONTAMINATION=0.1
ANOMALY_THRESHOLD=-0.3
DETECTION_INTERVAL_SECONDS=30

# DevInsight AI - Local Development
# Copy this file and update values as needed

# Database - using SQLite for local dev without Docker
DATABASE_URL=sqlite+aiosqlite:///./devinsight_dev.db
DATABASE_URL_SYNC=sqlite:///./devinsight_dev.db

# Gemini AI - add your key here
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Application
APP_ENV=development
SECRET_KEY=dev-secret-key-local-only
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Monitoring Mode
MONITORING_MODE=demo

# Prometheus (Live Mode - not needed for demo)
PROMETHEUS_URL=http://localhost:9090

# Loki (Live Mode - not needed for demo)
LOKI_URL=http://localhost:3100

# OpenTelemetry (Live Mode - not needed for demo)
OTEL_COLLECTOR_URL=http://localhost:4318

# Anomaly Detection
ANOMALY_CONTAMINATION=0.1
ANOMALY_THRESHOLD=-0.3
DETECTION_INTERVAL_SECONDS=30
